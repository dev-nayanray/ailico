# ---------------------------------------------------------------------------
# AIlico environment variables
# Copy to .env.local for local development, or set in your hosting provider's
# dashboard for production. Everything except SITE_URL is optional at dev time.
# NEVER commit .env.local or real secrets to git.
# ---------------------------------------------------------------------------

# Public site URL — canonical base for metadata, sitemap, RSS, OG tags.
# No trailing slash. Set to your production domain when deployed.
NEXT_PUBLIC_SITE_URL=https://ailico.top

# --- Lead storage (REQUIRED before production launch) ----------------------
# Option A (recommended): Supabase free tier.
# 1. Create a project, then apply supabase/migrations/0001_create_leads.sql
#    (SQL editor or `supabase db push`).
# 2. Copy the Project URL and the service_role key from Settings → API.
# The service-role key is server-side only; the client module is guarded by
# `server-only` so it can never enter a browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option B/extra: JSON webhook notification for new leads (must be https).
# Works with Discord/Slack incoming webhooks or any endpoint accepting JSON.
CONTACT_WEBHOOK_URL=

# --- Shared rate limiting (recommended for multi-instance production) ------
# Upstash Redis free tier. REST API only — no dependency added. When unset,
# an in-memory per-instance limiter is used (with a production warning).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Trusted proxy / client IP strategy ------------------------------------
# "true" (default): trust CF-Connecting-IP / X-Forwarded-For headers, which
# is correct behind Cloudflare or a reverse proxy. "false": ignore headers
# (all clients share one rate-limit bucket).
TRUST_PROXY_HEADERS=true
